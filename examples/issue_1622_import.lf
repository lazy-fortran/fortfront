! Issue #1622: Support IMPORT statement in interface blocks
! IMPORT statements now appear before dummy argument declarations
! Ensures interface-scoped imports compile without additional fixes
module test_import
    type data_t
        integer value
    end type

    interface
        subroutine process_data(d)
            import data_t
            type(data_t) d
        end subroutine
    end interface
end module
