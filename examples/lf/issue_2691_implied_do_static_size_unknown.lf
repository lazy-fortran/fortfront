! Issue 2691: strict mode should skip non-static implied-do sizes
program main
    use, intrinsic :: iso_fortran_env, only: dp => real64
    implicit none

    real(dp), allocatable :: arr(:)
    integer :: i
    integer :: n

    read (*, *) n
    arr = [1.0d0, 2.0d0, 3.0d0]
    arr = [(real(i, dp), i=1, n)]
end program main
