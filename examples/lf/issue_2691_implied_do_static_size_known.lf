! Issue 2691: strict mode should detect size changes for implied-do array literals
program main
    use, intrinsic :: iso_fortran_env, only: dp => real64
    implicit none

    real(dp), allocatable :: arr(:)
    integer :: i

    arr = [1.0d0, 2.0d0, 3.0d0]
    arr = [(real(i, dp), i=1, 2)]
end program main
