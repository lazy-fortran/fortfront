! Test case for issue #2106: Monomorphized functions missing intent attributes
! This file tests monomorphized functions and subroutines to ensure they have intent

function add(a, b)
    add = a + b
end function

subroutine print_value(x)
    print *, x
end subroutine

! Test with various call sites to trigger monomorphization
x = add(5, 3)
y = add(2.5d0, 1.5d0)

call print_value(42)
call print_value(3.14d0)
call print_value("test")
