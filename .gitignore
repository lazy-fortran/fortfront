debug
# Ignore generic build directories everywhere by default
build

# But keep tracked test sources under test/build/
!test/build/
!test/build/**
packages/*/

# Compiled/generated Fortran and JSON files in project root
/*.f90
/*.lf
/*.json
/*_out.f90
/*.mod
/*.txt

# CMake build artifacts
cmake_test/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
CTestTestfile.cmake

# Test artifacts - prevent accidental commit of test-generated files
test_*.md
test_*.txt
*_test.md
*_test.txt
*_test.f
*_test.f90
test_results*
test_output*

# Executable test binaries
test_go_style_simple
test_minimal_components
test_simple_plugin_registry
test_standalone_events
test_output

# Temporary files
*.tmp
*.temp

# Debug binaries - prevent accidental commit of debug executables
debug_error_test
debug_*_test

# Draft directory - never commit draft work
draft/
!draft/.gitkeep

# Coverage reports
coverage/
coverage.*
coverage_html/
coverage_filtered.info
*.gcov
*.gcda
*.gcno
*.info
test_old_api.o

# Fortran build artifacts
*.mod
*.o
*.a
*.so

# Log files and outputs
*.log
build/**/*.log
*.err
*.out
cli_trace.txt
logs/
examples/external_tool_example
generated_tests/
fortfront_modules/

# Binary executables (common names)
a.out
*.exe
*.dll
*.dylib

# Editor and system files
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
